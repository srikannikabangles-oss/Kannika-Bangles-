{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:xml|txt|json))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "*-template.html"
    }
  },
  "rewrites": [
    {
      "source": "/bridal-jewellery-bangalore",
      "destination": "/bridal-jewellery-bangalore.html"
    },
    {
      "source": "/temple-jewellery-bangalore",
      "destination": "/temple-jewellery-bangalore.html"
    },
    {
      "source": "/bangles",
      "destination": "/api"
    },
    {
      "source": "/pendant-sets",
      "destination": "/api"
    },
    {
      "source": "/necklaces",
      "destination": "/api"
    },
    {
      "source": "/earrings",
      "destination": "/api"
    },
    {
      "source": "/shop",
      "destination": "/api"
    },
    {
      "source": "/blog",
      "destination": "/api"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api"
    },
    {
      "source": "/areas",
      "destination": "/api"
    },
    {
      "source": "/areas/:location",
      "destination": "/api"
    },
    {
      "source": "/checkout",
      "destination": "/api"
    },
    {
      "source": "/product/:id",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "redirects": [
    {
      "source": "/shop.html",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "bangles"
        }
      ],
      "destination": "/bangles",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "pendant-sets"
        }
      ],
      "destination": "/pendant-sets",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/shop",
      "permanent": true
    }
  ]
}
