{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:xml|txt|json))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "redirects": [
    {
      "source": "/shop.html",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "bangles"
        }
      ],
      "destination": "/bangles",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "necklaces"
        }
      ],
      "destination": "/necklaces",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "earrings"
        }
      ],
      "destination": "/earrings",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/shop",
      "permanent": true
    }
  ]
}